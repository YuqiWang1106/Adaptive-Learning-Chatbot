# Core Django
DJANGO_DEBUG=true
# Leave blank for a temporary local development key; set a persistent random key for deployment.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_DB_ENGINE=django.db.backends.sqlite3
SQLITE_PATH=db.sqlite3
SQLITE_TIMEOUT_SECONDS=60
DB_CONN_MAX_AGE=0

# Optional shared runtime for production
REDIS_URL=
LEARNING_USE_CELERY=false
# /readyz waits this long for at least one Celery worker when Celery is enabled.
LEARNING_CELERY_WORKER_HEALTHCHECK_TIMEOUT_SECONDS=1.0
# SQLite local jobs run inline to avoid concurrent writers. Development with
# a server database can set this false for the background-thread fallback.
LEARNING_LOCAL_TASKS_INLINE=true

# OpenAI-backed product capabilities
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-2025-04-14
LEARNING_SELF_ASSESSMENT_V2_ENABLED=true
LEARNING_SELF_ASSESSMENT_MODEL=gpt-5.6-sol
LEARNING_SELF_ASSESSMENT_REASONING_EFFORT=medium
LEARNING_SELF_ASSESSMENT_TIMEOUT_SECONDS=120
LEARNING_SELF_ASSESSMENT_BLUEPRINT_MODEL=gpt-5.6-sol
LEARNING_SELF_ASSESSMENT_BLUEPRINT_REASONING_EFFORT=medium
LEARNING_SELF_ASSESSMENT_TEMPLATE_MODEL=gpt-5.6-terra
LEARNING_ADAPTIVE_PROBE_MODEL=gpt-5.6-terra
LEARNING_ADAPTIVE_GRADER_MODEL=gpt-5.6-sol
LEARNING_CONCEPT_MAP_MODEL=gpt-4.1-2025-04-14
LEARNING_AGENT_V2_ENABLED=true
LEARNING_AGENT_MODEL=gpt-5.6-sol
LEARNING_AGENT_REASONING_EFFORT=medium
LEARNING_AGENT_CHECKPOINT_ENCRYPTION_KEY=
LEARNING_ADAPTIVE_TRACE=true
LEARNING_SELF_ASSESSMENT_REPORT_TRACE=true

# Set true only when Celery workers can read the same filesystem-backed uploads.
LEARNING_MATERIAL_STORAGE_SHARED=false

# Optional Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
